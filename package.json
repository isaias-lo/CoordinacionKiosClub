  "scripts": {
    "copy-pdf-worker": "node -e \"const fs=require('fs');fs.mkdirSync('public',{recursive:true});fs.copyFileSync('node_modules/pdfjs-dist/build/pdf.worker.min.mjs','public/pdf.worker.min.mjs');fs.copyFileSync('node_modules/pdfjs-dist/build/pdf.min.mjs','public/pdf.min.mjs');\"",
    "prebuild": "npm run copy-pdf-worker",
    "predev": "npm run copy-pdf-worker",
    "dev": "next dev",
    "build": "node --max-old-space-size=4096 node_modules/next/dist/bin/next build",
    "start": "next start",
    "lint": "next lint",
    "hola": "node scripts/run.cjs hola",
    "bye": "node scripts/run.cjs bye",
    "sync": "node scripts/run.cjs sync",
    "pr": "node scripts/run.cjs pr",
    "nueva-tarea": "node scripts/run.cjs nueva-tarea",
    "test": "vitest run",
    "test:watch": "vitest"
  },
